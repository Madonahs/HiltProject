<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/student_list">

    <fragment
        android:id="@+id/student_list"
        android:name="com.madonasyombua.learninghilt.ui.fragment.StudentListsFragment"
        android:label="StudentList"
        tools:layout="@layout/student_lists_fragment"
        >

        <action
            android:id="@+id/action_student"
            app:destination="@id/list_of_students"
            app:popUpTo="@id/student_list" />
    </fragment>
    <fragment
        android:id="@+id/list_of_students"
        android:name="com.madonasyombua.learninghilt.ui.fragment.ListOfStudentFragment"
        android:label="StudentList"
        tools:layout="@layout/list_of_student_fragment" />

    <fragment
        android:id="@+id/login_in_fragment"
        android:name="com.madonasyombua.learninghilt.ui.fragment.LoginFragment"
        android:label="LoginList"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_in_fragment_to_list_of_students"
            app:destination="@id/list_of_students" />
        <deepLink
            android:id="@+id/deepLink"
            android:autoVerify="true"
            app:uri="https://streem.swac.streem.team/?invite={inviteCode}" />
    </fragment>

</navigation>